---
import PostList from '../components/PostList.astro';
import { site } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { sectionIds, sections } from '../lib/sections';

const posts = await getPosts();
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-heading">
    <p class="eyebrow">A personal corner of the internet</p>
    <h1 id="intro-heading">Hi, I’m {site.name}.</h1>
    <p class="intro-description">{site.description}</p>
    <a class="text-link" href="/blog/">Read my writing <span aria-hidden="true">→</span></a>
  </section>

  {sectionIds.map((id) => {
    const section = sections[id];
    const latest = posts.filter((post) => post.data.section === id).slice(0, 5);
    return (
      <section class="writing-section" aria-labelledby={`${id}-heading`}>
        <div class="section-heading">
          <h2 id={`${id}-heading`}>Recent {section.title.toLowerCase()}</h2>
          <a class="text-link" href={section.href}>All {section.title.toLowerCase()} <span aria-hidden="true">→</span></a>
        </div>
        <p class="section-description">{section.description}</p>
        {latest.length ? <PostList posts={latest} compact /> : <p class="muted">{section.empty}</p>}
      </section>
    );
  })}
</BaseLayout>
