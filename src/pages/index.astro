---
import PostList from '../components/PostList.astro';
import { site } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="intro" aria-labelledby="intro-heading">
    <p class="eyebrow">A personal corner of the internet</p>
    <h1 id="intro-heading">Hi, I’m {site.name}.</h1>
    <p class="intro-description">{site.description}</p>
    <a class="text-link" href="/blog/">Read my writing <span aria-hidden="true">→</span></a>
  </section>

  <section class="writing-section" aria-labelledby="writing-heading">
    <div class="section-heading">
      <h2 id="writing-heading">Latest writing</h2>
      <a class="text-link" href="/blog/">All posts <span aria-hidden="true">→</span></a>
    </div>
    {posts.length ? <PostList posts={posts} /> : <p class="muted">New posts will appear here soon.</p>}
  </section>
</BaseLayout>
