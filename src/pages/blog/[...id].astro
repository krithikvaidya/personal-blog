---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';
import { sections } from '../../lib/sections';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const section = sections[post.data.section];
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.description} section={post.data.section}>
  <article>
    <header class="article-header">
      <a class="text-link" href={section.href}><span aria-hidden="true">←</span> All {section.title.toLowerCase()}</a>
      {post.data.draft && <p class="eyebrow" style="margin-top: 2rem; margin-bottom: 0;">Draft · Local preview</p>}
      <h1>{post.data.title}</h1>
      <p class="intro-description">{post.data.description}</p>
      <time datetime={post.data.pubDate.toISOString()}>{date}</time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
