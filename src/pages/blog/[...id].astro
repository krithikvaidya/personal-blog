---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.pubDate.toLocaleDateString('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="article-header">
      <a class="text-link" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
      <h1>{post.data.title}</h1>
      <p class="intro-description">{post.data.description}</p>
      <time datetime={post.data.pubDate.toISOString()}>{date}</time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
